# Required in a real deployment. Generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret

# Local default is app/backend/data/globalbites.db.
# On Railway mount a persistent volume at /data and use:
GLOBALBITES_DB_PATH=/data/globalbites.db

# Optional release identifier surfaced by /api/health.
RELEASE_SHA=replace-with-final-git-sha

# Seed documented demo identities (1=yes, 0=no).
SEED_DEMO_USERS=1

# Set to 1 only for a controlled Week 5 ML failure/recovery demonstration.
GLOBALBITES_ML_FORCE_FAILURE=0

# Set to 1 when deployment is HTTPS-only.
COOKIE_SECURE=1
